# LLM API configuration (supports any LLM API compatible with OpenAI SDK format)
# To use Ollama locally:
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen3.5:397b-cloud

# Embedding model (Ollama, optional)
# Default: nomic-embed-text-v2-moe
EMBEDDING_MODEL_NAME=nomic-embed-text-v2-moe

# ===== Accelerated LLM configuration (optional) =====
# Note: if you do not use the accelerated configuration, do not include the following entries in the .env file
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
